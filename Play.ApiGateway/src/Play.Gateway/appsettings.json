{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Clusters": {
      "catalog-cluster" : {
        "Destinations": {
          "catalog-service" : {
            "Address": "http://localhost:5236"
          }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "inventory-service" : {
            "Address": "http://localhost:5111"
          }
        }
      }
    },
    "Routes": {
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": {
          "Path": "/items/{**catch-all}"
        }
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": {
          "Path": "/inventory/{**catch-all}"
        }
      }
    }
  }
}
